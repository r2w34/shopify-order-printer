// LetsPrint - Order Printer Database Schema
// GST-compliant order printing for Indian Shopify stores

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Shopify Session Management (Required by @shopify/shopify-app-remix)
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  @@index([shop])
}

// App Installation Tracking
model AppInstallation {
  id            String    @id @default(uuid())
  shop          String    @unique
  isActive      Boolean   @default(true)
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?
  
  settings      AppSettings?
  
  @@index([shop])
}

// App Settings per Shop
model AppSettings {
  id                String   @id @default(uuid())
  shop              String   @unique
  
  // GST Settings
  defaultGstRate    Float    @default(0.18)
  gstNumber         String?
  companyName       String?
  companyAddress    String?
  storeState        String   @default("Gujarat")
  
  // PDF Settings
  pdfHeaderText     String?
  pdfFooterText     String?
  includeLogo       Boolean  @default(true)
  logoUrl           String?
  
  // Template Settings
  defaultTemplate   String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  installation      AppInstallation @relation(fields: [shop], references: [shop], onDelete: Cascade)
  
  @@index([shop])
}

// Custom Templates for PDF/CSV
model Template {
  id            String   @id @default(uuid())
  shop          String
  name          String
  type          String   // 'PDF' or 'CSV'
  content       String   // Template content/configuration
  isDefault     Boolean  @default(false)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([shop])
  @@index([shop, type])
}

// Print Job Queue for Bulk Operations
model PrintJob {
  id            String   @id @default(uuid())
  shop          String
  jobType       String   // 'PDF' or 'CSV'
  status        String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  
  // Job Details
  orderIds      String[] // Array of order IDs
  totalOrders   Int
  processedOrders Int    @default(0)
  
  // Output
  fileKey       String?  // Key for retrieving the generated file
  fileUrl       String?
  
  // Timestamps
  createdAt     DateTime @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  
  // Error handling
  errorMessage  String?
  
  @@index([shop])
  @@index([shop, status])
}

// Webhook Event Logs
model WebhookLog {
  id              String   @id @default(uuid())
  shop            String
  topic           String
  webhookId       String
  payload         Json
  status          String   @default("RECEIVED") // RECEIVED, PROCESSED, FAILED
  processingTimeMs Int?
  errorMessage    String?
  
  receivedAt      DateTime @default(now())
  processedAt     DateTime?
  
  @@index([shop])
  @@index([shop, topic])
  @@index([receivedAt])
}
